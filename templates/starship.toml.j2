# Managed by Ansible ({{ ansible_managed | default('mac_setup') }}) — edit templates/starship.toml.j2
# Reference: https://starship.rs/config/

# Single line: <dir> <branch><dirty markers> <k8s ctx> ❯
format = "$directory$git_branch$git_status${custom.git_lines}$kubernetes$character"
add_newline = true
# Default 30ms is too tight for big directories like /tmp (prints a scan warning).
scan_timeout = 100

[directory]
truncation_length = 3
truncate_to_repo = true
style = "bold cyan"

[git_branch]
format = "on [$branch]($style) "
style = "bold purple"

# Colour-coded by meaning, each marker carrying a file count:
#   green +2  staged            yellow !3  modified, unstaged
#   red   ✘1  deleted           cyan   ?1  untracked
#   red   =1  conflicted        purple »1  renamed
# Module style is empty so the per-marker colours below win.
[git_status]
format = "([$all_status$ahead_behind]($style) )"
style = ""
staged = "[+${count}](bold green)"
untracked = "[?${count}](bold cyan)"
modified = "[!${count}](bold yellow)"
deleted = "[✘${count}](bold red)"
conflicted = "[=${count}](bold red)"
renamed = "[»${count}](bold purple)"
stashed = "[\\$](bold blue)"
ahead = "[⇡${count}](bold green)"
behind = "[⇣${count}](bold red)"
diverged = "[⇕⇡${ahead_count}⇣${behind_count}](bold red)"

# Off by default (noisy); shows only in dirs with k8s manifests.
[kubernetes]
disabled = false
format = '[⎈ $context(\($namespace\))]($style) '
style = "dimmed blue"
detect_files = ["kustomization.yaml", "Chart.yaml", "skaffold.yaml"]
detect_extensions = []

# Added/removed *line* counts for unstaged work (green +24, red -40), the way
# Warp showed it. The markers above count files; this counts lines.
# Costs one `git diff --shortstat` per prompt — set disabled = true if a big
# repo ever feels sluggish. Emits its own ANSI colours, hence style = "".
[custom.git_lines]
description = "Unstaged insertions/deletions"
when = "git rev-parse --is-inside-work-tree"
command = '''git diff --shortstat | awk '{ins=0;del=0; for(i=1;i<=NF;i++){if($i ~ /insert/) ins=$(i-1); if($i ~ /delet/) del=$(i-1)} if(ins>0) printf "\033[32m+%s\033[0m", ins; if(ins>0&&del>0) printf " "; if(del>0) printf "\033[31m-%s\033[0m", del}' '''
shell = ["bash", "--noprofile", "--norc"]
format = "$output "
style = ""
disabled = false

[character]
success_symbol = "[❯](bold green)"
error_symbol = "[❯](bold red)"

[cmd_duration]
min_time = 5000
format = "took [$duration](bold yellow) "
