---
# Accommodates the repo's existing style: aligned inline dicts in vars.yml,
# long annotated lines, and task files without document-start markers.
extends: default

rules:
  line-length:
    max: 140
  braces:
    max-spaces-inside: 1
  document-start: disable
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    check-keys: false
